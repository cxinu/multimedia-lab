# Copy to .env and fill in (never commit .env):
# Get a key at https://elevenlabs.io (free tier works for speech-to-speech
# with premade default voices + your own Voice Design voices).
ELEVENLABS_API_KEY=
# Optional default voice (name george/sarah or raw voice_id, e.g. a Voice
# Design voice). Falls back to george when unset:
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
